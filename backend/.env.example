# ============================================================
# Look-Alike Website Detector — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Gemma AI Backend ---
# Options: google | ollama | mock
GEMMA_BACKEND=mock

# Model name (defaults: gemma-4-26b-a4b-it for google, gemma4:e4b for ollama)
# GEMMA_MODEL=

# Google AI Studio API key (required if GEMMA_BACKEND=google)
# GOOGLE_API_KEY=your-api-key-here

# Ollama base URL (default: http://localhost:11434/v1)
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Google Safe Browsing (optional) ---
# SAFE_BROWSING_API_KEY=your-safe-browsing-key

# --- Admin ---
ADMIN_TOKEN=changeme-admin-token

# --- Database ---
# DATABASE_URL=sqlite:///./lookalike.db

# --- Rate Limiting ---
# RATE_LIMIT_PER_MINUTE=60
